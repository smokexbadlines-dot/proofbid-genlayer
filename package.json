{
  "name": "proofbid-genlayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "verify:proof": "node deploy/verify-proof.mjs",
    "verify:wallet": "node deploy/verify-browser-wallet.mjs",
    "verify:no-bid": "node deploy/verify-browser-wallet.mjs --manifest=browser-no-bid-proof.json"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.1.7"
  }
}
